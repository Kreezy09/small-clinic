# Copy to .env and adjust for your machine.

# Django secret key. Required; use a long random value outside local development.
DJANGO_SECRET_KEY=local-development-only-change-me
# Debug mode. Default: false
DJANGO_DEBUG=true
# Comma-separated hosts the API serves. Default: empty
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection. Docker Compose overrides POSTGRES_HOST and POSTGRES_PORT
# for the web container so it reaches the db service directly.
POSTGRES_DB=small_clinic
POSTGRES_USER=small_clinic
POSTGRES_PASSWORD=small_clinic
# Database host. Default: localhost
POSTGRES_HOST=localhost
# Database port. Default: 5432. Docker Compose publishes the db service on 5433.
POSTGRES_PORT=5433
# Host port Docker Compose publishes the db service on. Default: 5433
POSTGRES_HOST_PORT=5433

# IANA time zone of the clinic; working hours are local clock times in it. Default: Africa/Nairobi
CLINIC_TIMEZONE=Africa/Nairobi
# Minimum minutes between now and an appointment's start for it to be bookable. Default: 60
BOOKING_MIN_LEAD_MINUTES=60
